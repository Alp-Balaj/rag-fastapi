# Required for /ask
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# RAG_CLAUDE_MODEL=claude-opus-5-5
# RAG_EFFORT=medium
# RAG_TOP_K=4
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=150
# RAG_INDEX_PATH=index.json

# Your notes folder (e.g. an Obsidian vault). Enables `rag-ingest` with no
# argument and the web UI's Re-sync button. Quote paths with spaces.
# RAG_NOTES_DIR="~/Documents/My Vault"
# Folders or files to skip, comma-separated, relative to RAG_NOTES_DIR.
# Hidden folders (.obsidian, .git, ...) are always skipped.
# RAG_NOTES_EXCLUDE="Private, Archive/Old"
# Vault name for "Open in Obsidian" links (defaults to the folder name)
# RAG_OBSIDIAN_VAULT=
